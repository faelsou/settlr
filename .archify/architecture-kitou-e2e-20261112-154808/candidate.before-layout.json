  "cards": [
    {
      "dot": "emerald",
      "title": "Regra de ouro",
      "items": [
        "O LLM lê comprovante, classifica intenção e conversa",
        "Régua, matching e baixa são código determinístico",
        "Baixa definitiva só com confirmação do banco"
      ]
    },
    {
      "dot": "cyan",
      "title": "Volta do dinheiro",
      "items": [
        "O Beat agenda a régua, a promessa das 07:00 e o extrato",
        "O pull lê Open Finance e, se houver, o extrato do emissor",
        "Depois da baixa, o cadastro chama receiveInCash"
      ]
    },
    {
      "dot": "amber",
      "title": "Borda",
      "items": [
        "Traefik publica app. e api. Em dev, o gateway emite o JWT",
        "wa. tem allowlist; o webhook da Evolution chama o gateway por dentro",
        "E-mail da régua e do convite só sai com SMTP_HOST. OTLP, Sentry e Langfuse ficam desligados sem variável"
      ]
    }
  ]
