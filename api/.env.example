# Desenvolvimento local, apontando para docker/compose.dev.yml.
# Em produção nada disto existe: as senhas chegam como secrets do Swarm.
ENV=dev
DATABASE_HOST=localhost
DATABASE_PORT=55432
POSTGRES_PASSWORD=cobranca
POSTGRES_APP_PASSWORD=cobranca_app
REDIS_HOST=localhost
REDIS_PORT=56379
S3_ENDPOINT=http://localhost:59000
MINIO_ROOT_PASSWORD=cobranca-dev
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
JWT_SECRET=dev-secret-change-me
WEBHOOK_HMAC=dev-webhook-secret
# Produção: identificador do parecer no SETL-15. Vazio bloqueia POST /admin/tenants/{id}/activate.
LEGAL_OPINION_REF=
LLM_MODEL=openai:gpt-4o-mini
LLM_API_KEY=

# Onboarding e régua (D+15). A senha é a senha de app do Gmail, não a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=settlr.ss@gmail.com
SMTP_PASSWORD=
SMTP_FROM=settlr.ss@gmail.com
PANEL_BASE_URL=http://localhost:3000

# Gateway → serviços. Estes são os padrões do host; no compose do profile `app` a rede interna troca.
COBRANCA_URL=http://127.0.0.1:8001
CONCILIACAO_URL=http://127.0.0.1:8002
CADASTRO_URL=http://127.0.0.1:8003

# Observabilidade opcional. Vazio = desligado. Não há serviço de Langfuse nem Sentry no deploy.
# Coletor OpenTelemetry (gRPC): traces, métricas e logs. Com observability/ no ar: http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
