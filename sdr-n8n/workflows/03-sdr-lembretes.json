    {
      "id": "52150a89-adb5-52e0-95fe-14f8603960fb",
      "name": "Guardar na memória",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into sdr_chat_memory (session_id, message)\nvalues ($1, jsonb_build_object('type', 'ai', 'content', $2::text,\n        'additional_kwargs', '{}'::jsonb, 'response_metadata', '{}'::jsonb, 'tool_calls', '[]'::jsonb,\n        'invalid_tool_calls', '[]'::jsonb))",
        "options": {
          "queryReplacement": "={{ [ $('Escrever lembrete').item.json.phone, $('Escrever lembrete').item.json.text ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SDR_CRED_PG",
          "name": "Kitou SDR Postgres"
        }
      }
    },
    {
      "id": "297dd8d6-31b3-5967-a229-9f0976788b58",
      "name": "Fechar reuniões passadas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        520
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "with r as (\n  update sdr_meetings set status = 'realizada'\n   where status in ('agendada','confirmada') and end_at < now() - interval '1 hour'\n  returning lead_id\n)\nupdate sdr_leads set stage = 'realizado', updated_at = now()\n where id in (select lead_id from r) and stage = 'agendado'",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "SDR_CRED_PG",
          "name": "Kitou SDR Postgres"
        }
      }
    }
