      "id": "e5c1fced-1ceb-569b-a74a-ba62ecb124ab",
      "name": "Janela de busca",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst agora = DateTime.now().setZone(cfg.timezone);\nreturn [{ json: {\n  timeMin: agora.toISO(),\n  timeMax: agora.plus({ days: cfg.dias_busca + 1 }).endOf('day').toISO(),\n} }];\n"
      }
    },
