    {
      "id": "dbe43866-681b-5ab6-91d1-94d934abab17",
      "name": "Dados do lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select l.id, l.name, l.company, l.email, l.phone, l.segment, l.monthly_charges, l.issuer, l.pain, l.summary, l.fit,\n       (select to_char(start_at at time zone 'America/Sao_Paulo', 'DD/MM \"às\" HH24:MI')\n          from sdr_meetings where lead_id = l.id and status in ('agendada','confirmada') and start_at > now()\n          order by start_at limit 1) as ja_marcada\n  from sdr_leads l where l.phone = $1",
        "options": {
          "queryReplacement": "={{ [ $('Entrada').first().json.phone ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SDR_CRED_PG",
          "name": "Settlr SDR Postgres"
        }
      }
    },
