    {
      "id": "92258951-889d-57a0-806e-db8a2c0ef4dd",
      "name": "Guardar na memória",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into sdr_chat_memory (session_id, message)\nvalues ($1, jsonb_build_object('type', 'ai', 'content', $2::text,\n        'additional_kwargs', '{}'::jsonb, 'response_metadata', '{}'::jsonb, 'tool_calls', '[]'::jsonb,\n        'invalid_tool_calls', '[]'::jsonb))",
        "options": {
          "queryReplacement": "={{ [ $('Mensagem de abertura').item.json.phone, $('Mensagem de abertura').item.json.text ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SDR_CRED_PG",
          "name": "Kitou SDR Postgres"
        }
      }
    },
    {
      "id": "92338478-c251-5281-8fb1-4f1852eaabdb",
      "name": "Registrar abertura",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2420,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "update sdr_leads set last_outbound_at = now(), stage = 'conversando',\n       next_followup_at = now() + interval '1 day', updated_at = now()\n where phone = $1",
        "options": {
          "queryReplacement": "={{ [ $('Resolver número').first().json.phone ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SDR_CRED_PG",
          "name": "Kitou SDR Postgres"
        }
      },
      "executeOnce": true
    }
