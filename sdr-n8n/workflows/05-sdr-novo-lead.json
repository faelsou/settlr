    {
      "id": "114cc0ea-3eb8-5411-83cc-84dffda3ef5c",
      "name": "Normalizar lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nlet tel = String(b.telefone || b.phone || b.whatsapp || '').replace(/\\D/g, '');\nif (tel.length === 10 || tel.length === 11) tel = '55' + tel;\nif (tel.length < 12) return [];\nreturn [{ json: {\n  phone: tel,\n  nome: String(b.nome || b.name || '').trim(),\n  empresa: String(b.empresa || b.company || '').trim(),\n  email: String(b.email || '').trim(),\n  segmento: String(b.segmento || '').trim().toLowerCase(),\n  origem: String(b.origem || b.utm_source || 'formulario').trim(),\n  mensagem: String(b.mensagem || b.message || '').trim().slice(0, 500),\n} }];\n"
      }
    },
    {
      "id": "293e7aa8-23db-5d27-af9a-f59fdf711e3a",
      "name": "Checar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.evolution_url }}/chat/whatsappNumbers/{{ $('Config').first().json.evolution_instance }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ numbers: [ $json.phone ] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SDR_CRED_EVOLUTION",
          "name": "Evolution SDR (apikey)"
        }
      }
    },
    {
      "id": "c6af9801-8ddb-5b2c-9b2e-425270e97408",
      "name": "Resolver número",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "// Usa o JID que o WhatsApp devolve: evita lead duplicado por causa do nono dígito.\nconst r = Array.isArray($json) ? $json[0] : ($json[0] ?? $json);\nconst lead = $('Normalizar lead').first().json;\nif (!r || r.exists === false || !r.jid) return [];\nreturn [{ json: { ...lead, phone: r.jid.split('@')[0] } }];\n"
      }
    },
    {
      "id": "1001b903-a5b9-5f29-b1dd-793bbbffb232",
      "name": "Criar lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into sdr_leads (phone, name, company, email, segment, source, stage, summary)\nvalues ($1, nullif($2,''), nullif($3,''), nullif($4,''),\n        case when $5 in ('clinica','escola','academia','condominio','software','servicos','bpo','banco','outro') then $5 end,\n        $6, 'novo', nullif('Mensagem do formulário: ' || $7, 'Mensagem do formulário: '))\non conflict (phone) do update set\n  name = coalesce(sdr_leads.name, excluded.name),\n  company = coalesce(sdr_leads.company, excluded.company),\n  email = coalesce(sdr_leads.email, excluded.email),\n  updated_at = now()\nreturning id, phone, name, (xmax = 0) as novo, last_outbound_at, opted_out_at",
        "options": {
          "queryReplacement": "={{ [ $json.phone, $json.nome, $json.empresa, $json.email, $json.segmento, $json.origem, $json.mensagem ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SDR_CRED_PG",
          "name": "Kitou SDR Postgres"
        }
      }
    },
    {
      "id": "13558d62-c2d4-5dab-9a18-615c3e87548c",
      "name": "Primeiro contato?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "6d5347cf-e701-5966-ae65-e317730ae59f",
              "leftValue": "={{ $json.novo || (!$json.last_outbound_at && !$json.opted_out_at) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "50eaa1f9-38f4-5f36-9db6-0f82d107616d",
      "name": "Mensagem de abertura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst l = $('Resolver número').first().json;\nconst nome = (l.nome || '').split(' ')[0];\nconst oi = nome ? `Oi, ${nome}! ` : 'Oi! ';\nconst empresa = l.empresa ? ` da ${l.empresa}` : '';\nconst abertura = `${oi}Aqui é a ${cfg.sdr_nome}, assistente virtual do time da Kitou. Vi que você deixou seu contato${empresa} no nosso site.`;\nconst pergunta = l.mensagem\n  ? `Li a sua mensagem por aqui. Pra eu entender melhor: hoje, como vocês conferem os PIX e boletos que entram contra o que foi cobrado?`\n  : `Pra eu te direcionar do jeito certo: hoje, como vocês conferem os PIX e boletos que entram contra o que foi cobrado?`;\nreturn [\n  { json: { phone: l.phone, text: abertura, delay: 2500 } },\n  { json: { phone: l.phone, text: pergunta, delay: 4000 } },\n];\n"
      }
    },
    {
      "id": "03c32ca9-ac04-5ecc-aa30-26c96d93942a",
      "name": "Enviar abertura",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        300
