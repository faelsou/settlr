          "name": "Evolution SDR (apikey)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "06e115d4-fb98-5311-a1df-f955a46296cc",
      "name": "Marcar como do bot",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1980,
        420
      ],
      "parameters": {
        "operation": "set",
        "key": "=sdr:sent:{{ $json.key.id }}",
        "value": "1",
        "keyType": "string",
        "expire": true,
        "ttl": 86400
      },
      "credentials": {
        "redis": {
          "id": "SDR_CRED_REDIS",
          "name": "Kitou SDR Redis"
        }
      },
      "onError": "continueRegularOutput"
