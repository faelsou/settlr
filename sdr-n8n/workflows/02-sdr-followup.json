    {
      "id": "3dbcba64-deba-580f-b970-ddfeabd26a2e",
      "name": "Preparar envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const leads = $('Leads devidos').all();\nreturn $input.all().map((item, i) => {\n  const l = leads[i].json;\n  const text = String(item.json.text || '').trim().replace(/^\"|\"$/g, '');\n  const pular = !text || /^PULAR\\b/i.test(text);\n  return { json: { lead_id: l.id, phone: l.phone, text, pular, delay: Math.min(1500 + text.length * 35, 7000) } };\n});\n"
      }
    },
