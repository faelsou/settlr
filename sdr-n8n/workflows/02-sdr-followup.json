    {
      "id": "128955d3-b411-5c76-98ee-15e91e46c0ff",
      "name": "Avançar cadência",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2200,
        420
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "with u as (\n  update sdr_leads\n     set followup_count   = followup_count + 1,\n         last_outbound_at = now(),\n         next_followup_at = case followup_count + 1\n                              when 1 then now() + interval '2 days'   -- D+3\n                              when 2 then now() + interval '4 days'   -- D+7\n                              when 3 then now() + interval '7 days'   -- D+14\n                              else null end,\n         stage            = case when followup_count + 1 >= $3::int then 'perdido' else stage end,\n         updated_at       = now()\n   where id = $1::bigint\n  returning phone\n)\ninsert into sdr_chat_memory (session_id, message)\nselect phone, jsonb_build_object('type', 'ai', 'content', $2::text,\n       'additional_kwargs', '{}'::jsonb, 'response_metadata', '{}'::jsonb, 'tool_calls', '[]'::jsonb,\n       'invalid_tool_calls', '[]'::jsonb)\n  from u",
        "options": {
          "queryReplacement": "={{ [ $('Preparar envio').item.json.lead_id, $('Preparar envio').item.json.text, $('Config').first().json.max_followups ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "SDR_CRED_PG",
          "name": "Kitou SDR Postgres"
        }
      }
    }
