    {
      "id": "22c10d3a-d504-5330-a846-8c720de4fea9",
      "name": "Enviar follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.evolution_url }}/message/sendText/{{ $('Config').first().json.evolution_instance }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.phone, text: $json.text, delay: $json.delay }) }}",
        "options": {
