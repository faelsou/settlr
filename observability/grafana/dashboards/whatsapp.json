{
  "uid": "whatsapp-e2e",
  "title": "WhatsApp — ponta a ponta",
  "description": "Mensagens de WhatsApp: aceita, roteada, enviada (Evolution aceitou o HTTP) e recibo no aparelho (entregue, lido ou falhou). Arquivo recebido é o comprovante gravado. Arquivo entregue é anexo de saída.",
  "tags": [
    "cobranca",
    "whatsapp"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "context",
        "label": "Contexto",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "webhook,sync,ignorado,instancia_desconhecida,grupo,contato_desconhecido,comprovante,promessa,opt_out,escalonado,contestacao,aprovacao,humano,agente,regua,operador,roteamento,ja_paguei,vou_pagar,parcelar_desconto,parar,hostil_sensivel,duvida,outro",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Mensagens",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Aceitas",
      "description": "Webhook enfileirou ou a sincronização gravou a mensagem.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "thanos"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(increase(whatsapp_messages_total{direction=\"entrada\",stage=\"aceita\",result=\"ok\"}[$__range])) or sum(increase(cobranca_whatsapp_messages_total{direction=\"entrada\",stage=\"aceita\",result=\"ok\"}[$__range])) or vector(0)",
          "legendFormat": "aceitas"
        }
      ]
    },
    {
