    {
      "id": 7,
      "type": "timeseries",
      "title": "Entrada por contexto",
      "description": "Uma mensagem roteada por contexto. O filtro Contexto vale aqui.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
