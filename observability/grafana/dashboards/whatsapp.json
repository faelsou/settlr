        "type": "prometheus",
        "uid": "thanos"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (context) (rate(whatsapp_messages_total{stage=\"roteada\",context=~\"$context\"}[5m])) * 60 or sum by (context) (rate(cobranca_whatsapp_messages_total{stage=\"roteada\",context=~\"$context\"}[5m])) * 60",
